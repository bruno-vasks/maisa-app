# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
# Build de verificação: `MAISA_DIST_DIR=.next-verificacao npx next build` roda com o `next dev`
# no ar sem clobberar o `.next` dele. Ver o ⚠️ do `distDir` em next.config.mjs.
/.next-*/

# espelho da LP estática (fonte é lp/, gerado por scripts/espelha-lp.mjs)
/public/lp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env*.local
# Cópias de segurança do env. Sem esta linha, `.env.local.bak-20260811` NÃO é
# ignorado (o padrão acima exige terminar em `.local`) e vai commitado com chave
# dentro — o vazamento clássico de "só um backup rápido antes de mexer".
.env*.bak*
# O exemplo é rastreado de propósito: é a documentação das variáveis.
!.env.local.example

# ─────────────────────────────────────────────────────────────
# Rascunho de sessão: screenshots de auditoria e sondagem (~74 MB).
#
# Ficam de fora porque git não esquece: um PNG de 1,3 MB commitado por engano fica
# no histórico para sempre, e `git rm` depois não devolve o espaço — todo clone
# futuro baixa os 74 MB de novo. Os arquivos continuam no disco, só não versionados.
#
# O que É versionado de propósito, e por quê:
#   .claude/skills/    → a skill maisa-design, que o Claude carrega
#   .claude/snapshots/ → a ÚNICA proteção da pasta v3 (ver CLAUDE.md do projeto)
#   .claude/fontes/    → o original das imagens publicadas em public/
#   public/**          → asset de runtime; sem ele a LP quebra
# ─────────────────────────────────────────────────────────────
.auditoria-perfil/
.auditoria-perfil-p/
.foto-perfil/
.perf-larg/
.sonda-perfil/
.claude/auditoria/
.claude/rostos/
.claude/*.png
# fotos da bancada (scripts/bancada/): a foto se refaz, o PNG no histórico não sai mais
/.bancada-fotos/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auditoria headless — sobra de execução, não fonte.
# Os scripts .mjs de .claude/ SÃO versionados: eles são a prova que acompanha a LP.
# O que fica de fora é só o que cada corrida cospe de novo.
/.auditoria-perfil*/
/.claude/auditoria/
/.claude/dev.log
.env*

# O Vercel CLI acrescentou `.env*` acima, e regra posterior vence — o que voltaria a
# ignorar o exemplo. Ele é rastreado de propósito: é a documentação das variáveis.
!.env.local.example
